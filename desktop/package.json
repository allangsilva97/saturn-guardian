{
  "name": "saturn-guardian",
  "productName": "Saturn Guardian",
  "version": "2.7.0",
  "description": "Retro 2D run-and-gun platformer",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-app": "node build-app.mjs",
    "start": "node build-app.mjs && electron .",
    "start:128": "node build-app.mjs 128 && electron .",
    "start:256": "node build-app.mjs 256 && electron .",
    "dist": "npm run dist:64 && npm run dist:128 && npm run dist:256",
    "dist:64": "node build-app.mjs 64 && electron-builder --win portable -c.portable.artifactName=SaturnGuardian-64bit.exe",
    "dist:128": "node build-app.mjs 128 && electron-builder --win portable -c.portable.artifactName=SaturnGuardian-128bit.exe",
    "dist:256": "node build-app.mjs 256 && electron-builder --win portable -c.portable.artifactName=SaturnGuardian-256bit.exe"
  },
  "build": {
    "appId": "com.saturnvanguard.game",
    "productName": "Saturn Guardian",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
